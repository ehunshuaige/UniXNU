# Kernel configuration common to the iOS 16 userland on this profile.
#
# Applied after arch:configs/common.config and the SoC fragment, before the
# device defconfig. These four are properties of the target OS, not of ruyi:
# they are what the iOS 16.7.16 userland needs from the kernel regardless of the
# board it runs on.

# The kernel is prelinked against the original Apple kernelcache, so its crypto
# comes from that image rather than from a freshly built module.
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"

# Trust cache handling for the prelinked kexts and the target userland.
CONFIG_XNU_TRUST_CACHE_RUNTIME=y

# A ramdisk root (rd=) rather than a mounted block device, which is how this
# profile boots; mockfs is what presents it.
CONFIG_XNU_SOURCE_MOCKFS=y

# Apple's chunked cdhash cache, needed by the prelinked image's code signing.
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
